<?xml version="1.0" encoding="utf-8"?>
<!--
  Typesake 线条图标（手绘矢量）：
  键帽（打字）+ 字母 A（英语）+ 笔迹与落点（书写/学习）。
  48x48 grid，纯描边无填充，可被 Compose tint 重新着色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 键帽 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,11 H36 A6,6 0 0 1 42,17 V27 A6,6 0 0 1 36,33 H12 A6,6 0 0 1 6,27 V17 A6,6 0 0 1 12,11 Z"
        android:strokeColor="#1B7A5A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="3" />

    <!-- 字母 A -->
    <path
        android:fillColor="#00000000"
        android:pathData="M18.5,28 L24,16.5 L29.5,28 M20.8,24.5 H27.2"
        android:strokeColor="#1B7A5A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.8" />

    <!-- 笔迹 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M13,38.5 C17,42.5 21,35.5 25,38.5 C28,40.6 31,39.8 34,37.5"
        android:strokeColor="#1B7A5A"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.8" />

    <!-- 落点 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36.8,36.9 L36.8,36.9"
        android:strokeColor="#1B7A5A"
        android:strokeLineCap="round"
        android:strokeWidth="3.6" />
</vector>
