<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 隐私护城河：不申请任何用户权限。DUMP 由依赖（profileinstaller 等）
         带进来，属签名级权限、普通应用永远不会被授予，这里显式移除，
         保证发布包权限表只剩系统强制的 BIND_INPUT_METHOD。 -->
    <uses-permission android:name="android.permission.DUMP" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Typesake">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HubActivity"
            android:exported="false"
            android:label="@string/hub_title" />

        <service
            android:name=".TypesakeImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
